DATABASE_URL=postgresql+psycopg2://postgres:postgres@database:5432/ulpf_database

# Set DATA_LAKE_ENABLED=true to enable scheduled Parquet exports.
DATA_LAKE_ENABLED=false
# Use 10 for local export testing; default production interval is 300 seconds.
DATA_LAKE_EXPORT_INTERVAL_SECONDS=300
DATA_LAKE_BATCH_SIZE=1000

MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_BUCKET=ulpf-datalake
MINIO_ENDPOINT=http://minio:9000
